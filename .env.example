# Template only. Replace placeholders locally; never commit a filled environment file.
# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=your_gemini_api_key

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL=http://localhost:3000

# PostgreSQL / Supabase Database URL
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DATABASE_NAME

# Cloud SQL / Direct PostgreSQL credentials (optional if DATABASE_URL is set)
SQL_HOST=""
SQL_DB_NAME=""
SQL_USER=""
SQL_PASSWORD=""
SQL_ADMIN_USER=""
SQL_ADMIN_PASSWORD=""

# JWT Secret for session & tokens (minimum 32 characters in production)
JWT_SECRET=replace_with_a_long_random_jwt_secret

# Real Administrator Configuration & Secure Bootstrap
ADMIN_EMAIL=admin@example.com
ADMIN_SETUP_KEY=replace_with_a_long_random_admin_setup_key

# SMTP Email Configuration for Real MFA & Password Reset Delivery
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_SECURE="false"
EMAIL_FROM=School Management <no-reply@example.com>
REQUIRE_SMTP="false"

# Demo Authentication Isolation
# Set to 'true' only in local development or staging demo testing. Disabled by default in production.
ENABLE_DEMO_LOGINS="false"

# Shared PostgreSQL multi-school tenancy
# The local development default is 'springfield'. Set a production default only
# when this deployment should route unlabelled requests to one specific school.
DEFAULT_SCHOOL_SLUG=""
# Optional: enables school subdomains such as springfield.schools.example.com
TENANT_ROOT_DOMAIN=""
# Required to use POST /api/platform/schools. Use a random value of at least 32 characters.
PLATFORM_ADMIN_KEY=replace_with_a_long_random_platform_key

# Demo-only PostgreSQL BYPASSRLS exception; keep false for real school data.
ALLOW_RLS_BYPASS_FOR_DEMO=false
